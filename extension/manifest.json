{
  "manifest_version": 3,
  "name": "Pioneer TV",
  "version": "0.1.0",
  "description": "TV shell for Chromium: launcher, gamepad spatial navigation, on-screen keyboard and HUD.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/pixel-icons.js",
        "content/bridge.js",
        "content/spatial-nav.js",
        "content/keyboard.js",
        "content/hud.js",
        "content/logs.js",
        "content/main.js"
      ],
      "css": [
        "content/paper.css",
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "go-home": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Go to the Pioneer TV launcher"
    },
    "toggle-keyboard": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Toggle the on-screen keyboard"
    },
    "toggle-menu": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Toggle the quick menu"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "launcher/*",
        "fonts/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ]
}
