# Extra environment for start-chromium.sh. Installed to /etc/pioneer-tv/chromium.env.
# PIONEER_TV_CHROMIUM_FLAGS="--force-device-scale-factor=1"
# Pi 4/5 only (VideoCore VI/VII do GLES 3): let the GPU composite.
# PIONEER_TV_CHROMIUM_FLAGS="--ignore-gpu-blocklist --enable-gpu-rasterization"
# If the screen stays grey, force software drawing to confirm it is the GPU:
# PIONEER_TV_CHROMIUM_FLAGS="--disable-gpu"
# PIONEER_TV_PROFILE=/home/pi/.pioneer-tv/chromium
