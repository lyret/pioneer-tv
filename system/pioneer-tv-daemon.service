[Unit]
Description=Pioneer TV daemon (gamepad, HDMI-CEC, extension bridge)
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m pioneertv --config /etc/pioneer-tv/config.toml
WorkingDirectory=/opt/pioneer-tv/daemon
Environment=PYTHONPATH=/opt/pioneer-tv/daemon
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=2
# Needs /dev/uinput, /dev/input/event* and /dev/cec0.
User=root

[Install]
WantedBy=multi-user.target
